---
import { getEntry, render } from "astro:content";
import Layout from "../layouts/Layout.astro";

const now = await getEntry("now", "index");
if (!now) throw new Error("Now content is missing");

const { Content } = await render(now);
const items = [now.data.work, now.data.learning, now.data.curiosity];
const updated = new Intl.DateTimeFormat("en", {
  year: "numeric",
  month: "long",
  day: "numeric",
  timeZone: "UTC",
}).format(now.data.updatedDate);
---

<Layout
  title="Now | Meezaan Davids"
  description="What Meezaan Davids is currently working on, learning, and thinking about."
>
  <div class="mx-auto max-w-[68rem] px-5 pb-24 pt-[8.5rem] sm:px-8 md:pb-32 md:pt-[9.5rem]">
    <header class="rounded-lg border border-border bg-surface p-6 shadow-sm md:p-8">
      <p class="font-mono text-[0.66rem] uppercase tracking-[0.2em] text-[var(--accent-secondary)]">
        Now
      </p>
      <div class="mt-6 grid gap-10 lg:grid-cols-[minmax(0,1.15fr)_minmax(20rem,0.85fr)] lg:gap-20">
        <h1 class="max-w-[36rem] text-[clamp(2.25rem,4.2vw,3.55rem)] font-semibold leading-[1.05] max-[700px]:max-w-[20.5rem] max-[700px]:text-[clamp(2.15rem,9.5vw,2.75rem)]">
          What has my attention now.
        </h1>
        <div class="max-w-[36rem] text-[1.04rem] leading-[1.7] text-muted max-[700px]:max-w-[20rem]">
          <Content />
          <p class="mt-8 font-mono text-[0.66rem] uppercase tracking-[0.14em] text-subtle">
            Updated {updated}
          </p>
        </div>
      </div>
    </header>

    <section class="py-16 md:py-20" aria-labelledby="now-list-heading">
      <div class="mb-8 flex flex-col gap-4 border-b border-border pb-6 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <p class="font-mono text-[0.66rem] uppercase tracking-[0.2em] text-[var(--accent-secondary)]">
            01
          </p>
          <h2 class="mt-2 text-[clamp(1.95rem,3.7vw,2.55rem)] font-semibold" id="now-list-heading">
            Current focus
          </h2>
        </div>
        <p class="font-mono text-[0.66rem] uppercase tracking-[0.2em] text-[var(--accent-secondary)]">
          Living record
        </p>
      </div>
      <div class="space-y-3">
      {
        items.map((item) => (
          <article class="rounded-lg border border-border bg-surface p-5 shadow-sm md:p-6">
            <div class="grid gap-3 lg:grid-cols-[9rem_minmax(0,1fr)] lg:items-center">
              <h3 class="font-display text-[clamp(1.35rem,2.6vw,1.7rem)] font-medium leading-tight">
                {item.title}
              </h3>
              <p class="text-sm leading-[1.7] text-muted lg:whitespace-nowrap">
                {item.text}
              </p>
            </div>
          </article>
        ))
      }
      </div>

    {
      now.data.links && (
        <nav class="flex flex-wrap gap-x-10 gap-y-6 pt-12" aria-label="Related pages">
          {now.data.links.map((link) => (
            <a
              class="inline-flex items-center gap-2 font-mono text-[0.72rem] text-primary underline decoration-transparent underline-offset-[0.28em] transition-[text-decoration-color] duration-[160ms] hover:decoration-current"
              href={link.href}
            >
              {link.label} <span aria-hidden="true">→</span>
            </a>
          ))}
        </nav>
      )
    }
    </section>
  </div>
</Layout>
