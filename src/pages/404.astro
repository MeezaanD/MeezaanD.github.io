---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Page not found | Meezaan Davids"
  description="The requested page could not be found."
>
  <div class="mx-auto flex min-h-[82vh] max-w-[68rem] flex-col justify-center px-5 pb-24 pt-32 sm:px-8">
    <div class="rounded-lg border border-border bg-surface p-6 shadow-sm md:p-8">
      <p class="font-mono text-[0.66rem] uppercase tracking-[0.2em] text-[var(--accent-secondary)]">
        Error 404
      </p>
      <div class="mt-6 grid gap-10 lg:grid-cols-[minmax(0,1.15fr)_minmax(20rem,0.85fr)] lg:gap-20">
        <h1 class="max-w-[36rem] text-[clamp(2.25rem,4.2vw,3.55rem)] font-semibold leading-[1.05] max-[700px]:max-w-[20.5rem] max-[700px]:text-[clamp(2.15rem,9.5vw,2.75rem)]">
          This page is not part of the map.
        </h1>
        <div class="max-w-[36rem] text-[1.04rem] leading-[1.7] text-muted max-[700px]:max-w-[20rem]">
          <p>
            The address may have changed, or the thing you were looking for may
            no longer live here.
          </p>
          <a
            class="mt-8 inline-flex items-center gap-2 rounded-md bg-primary px-4 py-2.5 font-mono text-[0.72rem] uppercase tracking-[0.12em] text-white shadow-sm transition-colors hover:bg-[var(--accent-secondary)]"
            href="/"
          >
            Return home <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</Layout>
