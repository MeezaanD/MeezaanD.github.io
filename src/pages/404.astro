---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Page not found | Meezaan Davids"
  description="The requested page could not be found."
>
  <div class="not-found">
    <div class="not-found__panel">
      <p class="not-found__kicker">
        Error 404
      </p>
      <div class="not-found__grid">
        <h1>
          This page is not part of the map.
        </h1>
        <div>
          <p>
            The address may have changed, or the thing you were looking for may
            no longer live here.
          </p>
          <a
            class="not-found__link"
            href="/"
          >
            Return home <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</Layout>
