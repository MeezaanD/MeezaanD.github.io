---
import { getCollection, getEntry } from "astro:content";
import Layout from "../layouts/Layout.astro";
import { site } from "../data/site";

const now = await getEntry("now", "index");
if (!now) throw new Error("Now content is missing");

const projects = (await getCollection("projects"))
  .filter((project) => project.data.liveLink)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 2);
---

<Layout title="Meezaan Davids | Developer">
  <div class="home-page">
    <section class="home-hero" aria-labelledby="home-heading">
      <div class="home-hero__brand">
        <img src="/meezaan-dev-logo.png" alt="Meezaan Dev" />
      </div>
      <div class="home-hero__copy">
        <p class="page-kicker">Developer</p>
        <h1 id="home-heading">Building useful interfaces with care.</h1>
        <p class="home-hero__summary">{now.data.work.text}</p>
        <a class="text-link" href="#work">See the work <span aria-hidden="true">↓</span></a>
      </div>
    </section>

    <section class="home-work" id="work" aria-labelledby="work-heading">
      <div class="section-heading">
        <div>
          <p class="page-kicker">Selected work</p>
          <h2 id="work-heading">Made for use.</h2>
        </div>
        <p>Two small systems. Real edges. Real use.</p>
      </div>

      <div class="project-list">
        {projects.map((project, index) => (
          <a
            class="project-list__item"
            href={project.data.liveLink}
            target="_blank"
            rel="noopener noreferrer"
          >
            <span class="project-list__number">0{index + 1}</span>
            <span class="project-list__body">
              <strong>{project.data.title}</strong>
              <span>{project.data.description}</span>
            </span>
            <span class="project-list__arrow" aria-hidden="true">↗</span>
          </a>
        ))}
      </div>
    </section>

    <section class="home-contact" id="contact" aria-labelledby="contact-heading">
      <p class="page-kicker">Contact</p>
      <h2 id="contact-heading">Make something clear.</h2>
      <a class="text-link" href={`mailto:${site.email}`}>
        {site.email} <span aria-hidden="true">↗</span>
      </a>
    </section>
  </div>
</Layout>
