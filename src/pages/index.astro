---
import { getCollection, getEntry } from "astro:content";
import Layout from "../layouts/Layout.astro";
import ScrollProgress from "../components/ScrollProgress.astro";
import StoryGlyph from "../components/StoryGlyph.astro";
import StoryScene from "../components/StoryScene.astro";
import { site } from "../data/site";

const now = await getEntry("now", "index");
if (!now) throw new Error("Now content is missing");

const nowItems = [
  { title: now.data.work.title, text: "Frontend at Yoyo." },
  { title: now.data.learning.title, text: "IT. Management. Better judgment." },
  { title: now.data.curiosity.title, text: "AI, taste, constraint." },
];
const experience = (await getCollection("experience")).sort(
  (a, b) => a.data.order - b.data.order,
);
const education = (await getCollection("education")).sort(
  (a, b) => a.data.order - b.data.order,
);
const featuredProjects = (await getCollection("projects"))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 2);
const currentRole = experience[0];
const latestLearning = education[0];
---

<Layout title="Meezaan Davids | A living notebook">
  <ScrollProgress />

  <div class="story-page">
    <StoryScene id="start" align="center" class="story-scene--opening">
      <div class="story-opening">
        <h1 id="start-heading" class="sr-only">Meezaan Dev</h1>
        <img
          class="story-opening__logo"
          src="/meezaan-dev-logo.png"
          alt="Meezaan Dev"
          draggable="false"
        />
        <p class="story-opening__caption">Build it.</p>
        <p class="story-opening__meta">interfaces / judgment / taste</p>
      </div>
    </StoryScene>

    <StoryScene id="now" align="left">
      <div class="story-split">
        <div>
          <h2 id="now-heading">Current gravity</h2>
          <div class="story-orbit" aria-label="Current focus">
            {nowItems.map((item) => (
              <article class="story-orbit__item">
                <span>{item.title}</span>
                <p>{item.text}</p>
              </article>
            ))}
          </div>
        </div>
        <StoryGlyph variant="thread" class="story-glyph--anchored" />
      </div>
    </StoryScene>

    <StoryScene id="profile" align="right">
      <div class="story-split story-split--reverse">
        <StoryGlyph variant="stack" class="story-glyph--anchored" />
        <div>
          <h2 id="profile-heading">Built by repetition</h2>
          <div class="story-timeline">
            {currentRole && (
              <article>
                <span>{currentRole.data.date}</span>
                <strong>{currentRole.data.title}</strong>
                <p>{currentRole.data.company}</p>
              </article>
            )}
            {latestLearning && (
              <article>
                <span>{latestLearning.data.date}</span>
                <strong>{latestLearning.data.title}</strong>
                <p>{latestLearning.data.institution}</p>
              </article>
            )}
          </div>
        </div>
      </div>
    </StoryScene>

    <StoryScene id="tools" align="left">
      <div class="story-showcase">
        <div class="story-showcase__head">
          <h2 id="tools-heading">Made, not listed.</h2>
          <p>Two small systems. Real edges. Real use.</p>
        </div>

        <div class="story-showcase__pieces">
          {featuredProjects.map((project, index) => (
            <a
              class:list={["story-piece", index === 0 ? "story-piece--primary" : "story-piece--secondary"]}
              href={project.data.liveLink}
              target="_blank"
              rel="noopener noreferrer"
            >
              <span class="story-piece__number">0{index + 1}</span>
              <span class="story-piece__title">{project.data.title}</span>
              <span class="story-piece__description">
                {project.data.title === "Cash Flow"
                  ? "Money, made visible."
                  : "Taste, queued up."}
              </span>
              <span class="story-piece__detail">{project.data.description}</span>
            </a>
          ))}
        </div>

        <div class="story-showcase__secondary" aria-label="Other places">
          {site.products.slice(2).map((item) => (
            <a href={item.href} target="_blank" rel="noopener noreferrer">
              {item.label}
            </a>
          ))}
        </div>
      </div>
    </StoryScene>

    <StoryScene id="contact" align="center">
      <div class="story-ending">
        <h2 id="contact-heading">Make something clear.</h2>
        <a href={`mailto:${site.email}`}>{site.email}</a>
      </div>
    </StoryScene>
  </div>
</Layout>
