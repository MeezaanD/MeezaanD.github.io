---
import { getEntry } from "astro:content";
import Layout from "../layouts/Layout.astro";
import { site } from "../data/site";

const now = await getEntry("now", "index");

const nowItems = now
  ? [now.data.work, now.data.learning, now.data.curiosity]
  : [];
const updated = now
  ? new Intl.DateTimeFormat("en", {
      year: "numeric",
      month: "long",
      day: "numeric",
      timeZone: "UTC",
    }).format(now.data.updatedDate)
  : "";
---

<Layout title="Meezaan Davids | Software, systems, and learning">
  <section class="mx-auto max-w-[68rem] px-5 pb-16 pt-[8.5rem] sm:px-8 md:pb-20 md:pt-[9.5rem]">
    <p class="font-mono text-[0.66rem] uppercase tracking-[0.2em] text-[var(--accent-secondary)]">
      {site.name}
    </p>
    <div class="reveal mt-6 rounded-lg bg-surface p-6 shadow-[0_24px_70px_rgba(15,23,42,0.08)] shadow-sm lg:p-8">
      <div class="grid gap-8 lg:grid-cols-[minmax(0,1.15fr)_minmax(20rem,0.85fr)] lg:gap-16">
      <div class="max-w-[42rem]">
        <h1 class="text-[clamp(2.5rem,5vw,4rem)] font-semibold leading-[1.02] max-[700px]:text-[clamp(2.3rem,11vw,3rem)]">
          <span class="max-[700px]:block">Building</span>{" "}
          <span class="max-[700px]:block">software</span>{" "}
          <span class="max-[700px]:block">with</span>{" "}
          <em class="font-display font-medium italic max-[700px]:block">judgment</em>{" "}
          <em class="font-display font-medium italic max-[700px]:block">and intention.</em>
        </h1>
      </div>
      <div class="max-w-[36rem] text-[1.04rem] leading-[1.7] text-muted">
        <p>
          I am a software developer interested in the whole system: the
          interface, the architecture beneath it, and the decisions that make
          technology useful to people.
        </p>
        <a
          class="mt-8 inline-flex items-center gap-2 rounded-md bg-primary px-4 py-2.5 font-mono text-[0.72rem] uppercase tracking-[0.12em] text-white shadow-sm transition-all duration-200 hover:-translate-y-0.5 hover:bg-[var(--accent-secondary)] hover:shadow-md"
          href="/now"
        >
          What I am focused on now <span aria-hidden="true">→</span>
        </a>
      </div>
      </div>
    </div>
  </section>

  <section
    class="mx-auto max-w-[68rem] px-5 py-16 sm:px-8 md:py-20"
    aria-labelledby="now-heading"
  >
    <div class="reveal mb-8 flex flex-col gap-4 border-b border-border pb-6 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <p class="font-mono text-[0.66rem] uppercase tracking-[0.2em] text-[var(--accent-secondary)]">
          Current state
        </p>
        <h2
          class="mt-2 text-[clamp(1.95rem,3.7vw,2.55rem)] font-semibold"
          id="now-heading"
        >
          Now
        </h2>
      </div>
      {updated && (
        <p class="font-mono text-[0.66rem] uppercase tracking-[0.14em] text-subtle">
          Updated {updated}
        </p>
      )}
    </div>
    <div class="space-y-3">
      {
        nowItems.map((item) => (
          <article class="reveal rounded-lg border border-border bg-surface p-5 shadow-sm transition-transform duration-200 hover:-translate-y-0.5 hover:shadow-md md:p-6">
            <div class="grid gap-3 lg:grid-cols-[9rem_minmax(0,1fr)] lg:items-center">
              <h3 class="font-display text-[clamp(1.35rem,2.6vw,1.7rem)] font-medium leading-tight">
                {item.title}
              </h3>
              <p class="text-sm leading-[1.7] text-muted lg:whitespace-nowrap">
                {item.text}
              </p>
            </div>
          </article>
        ))
      }
    </div>
    <div class="pt-8">
      <a
        class="inline-flex items-center gap-2 font-mono text-[0.72rem] text-primary underline decoration-transparent underline-offset-[0.28em] transition-[text-decoration-color] duration-[160ms] hover:decoration-current"
        href="/now"
      >
        The full update <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>

  <section
    class="mx-auto max-w-[68rem] border-t border-border px-5 py-16 sm:px-8 md:py-20"
    aria-labelledby="elsewhere-heading"
  >
    <div class="reveal mb-8 flex flex-col gap-4 border-b border-border pb-6 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <p class="font-mono text-[0.66rem] uppercase tracking-[0.2em] text-[var(--accent-secondary)]">
          Tools I built and use
        </p>
        <h2
          class="mt-2 text-[clamp(1.95rem,3.7vw,2.55rem)] font-semibold"
          id="elsewhere-heading"
        >
          Built for myself
        </h2>
      </div>
      <p class="font-mono text-[0.66rem] uppercase tracking-[0.2em] text-[var(--accent-secondary)]">
        Product notes
      </p>
    </div>
    <div class="space-y-3">
      {
        [...site.products].map(
          (item) => (
            <a
              class="reveal group block rounded-lg border border-border bg-surface p-5 shadow-sm transition-all duration-200 hover:-translate-y-0.5 hover:border-primary hover:shadow-md md:p-6"
              href={item.href}
              target="_blank"
              rel="noopener noreferrer"
            >
              <span class="flex flex-col gap-3 md:flex-row md:items-start md:justify-between">
                <span>
                  <span class="font-display text-[clamp(1.35rem,2.6vw,1.7rem)] font-medium leading-tight transition-colors group-hover:text-primary">
                    {item.label}
                  </span>
                  <span class="mt-2 block font-mono text-[0.74rem] text-primary">
                    External tool <span aria-hidden="true">↗</span>
                  </span>
                </span>
                <span class="max-w-[45rem] text-[1rem] leading-[1.7] text-muted md:text-right">
                  {item.description}
                </span>
              </span>
            </a>
          ),
        )
      }
    </div>
  </section>

  <section
    class="mx-auto max-w-[68rem] border-t border-border px-5 pb-32 pt-16 sm:px-8 md:pt-20"
    id="contact"
    aria-labelledby="contact-heading"
  >
    <div class="reveal mb-8 flex flex-col gap-4 border-b border-border pb-6 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <p class="font-mono text-[0.66rem] uppercase tracking-[0.2em] text-[var(--accent-secondary)]">
          Contact
        </p>
        <h2
          class="mt-2 text-[clamp(1.95rem,3.7vw,2.55rem)] font-semibold"
          id="contact-heading"
        >
          Say hello.
        </h2>
      </div>
      <p class="font-mono text-[0.66rem] uppercase tracking-[0.2em] text-[var(--accent-secondary)]">
        Open inbox
      </p>
    </div>
    <p class="mb-7 max-w-[36rem] text-[1.04rem] leading-[1.7] text-muted">
      For thoughtful conversations about software, systems, and the work around
      them.
    </p>
    <a
      class="inline-flex items-center gap-2 rounded-md bg-primary px-4 py-2.5 font-mono text-[0.72rem] uppercase tracking-[0.12em] text-white shadow-sm transition-all duration-200 hover:-translate-y-0.5 hover:bg-[var(--accent-secondary)] hover:shadow-md"
      href={`mailto:${site.email}`}
    >
      {site.email} <span aria-hidden="true">→</span>
    </a>
  </section>
</Layout>
