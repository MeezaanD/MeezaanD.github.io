---
import { site } from "../data/site";
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <div>
      <p class="site-footer__line">A small place for work and thought.</p>
      <a
        class="site-footer__mail"
        href={`mailto:${site.email}`}
      >
        {site.email}
      </a>
    </div>
    <div class="site-footer__meta">
      <nav class="site-footer__links" aria-label="Footer">
        {[...site.social, ...site.references].map((item) => (
          <a
            href={item.href}
            class="site-footer__link"
            target={item.href.startsWith("http") || item.href.endsWith(".pdf") ? "_blank" : undefined}
            rel={item.href.startsWith("http") || item.href.endsWith(".pdf") ? "noopener noreferrer" : undefined}
          >
            {item.label}
          </a>
        ))}
      </nav>
      <p class="site-footer__copyright">
        &copy; {new Date().getFullYear()} {site.name}
      </p>
    </div>
  </div>
</footer>
