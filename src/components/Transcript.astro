---
import { getCollection } from "astro:content";

type TranscriptItem = {
  section: string;
  title: string;
  institution: string;
  status: "Completed" | "In Progress";
  date?: string;
  description?: string;
  detail?: string;
  tagLabel?: string;
  tags?: string[];
  certificateImage?: string;
  certificateAlt?: string;
  order: number;
};

const rawCollections = await getCollection("transcript");
const entries = rawCollections
  .flatMap((entry) => entry.data as TranscriptItem[])
  .sort((a, b) => a.order - b.order);

const sectionOrder = [
  "Formal Degree",
  "Bootcamps & Institutions",
  "Online Courses — Udemy",
  "Online Courses — Great Learning",
];

const grouped = sectionOrder
  .map((section) => ({
    id: `transcript-${section
      .toLowerCase()
      .replace(/[^a-z0-9]+/g, "-")
      .replace(/^-|-$/g, "")}`,
    section,
    items: entries.filter((entry) => entry.section === section),
  }))
  .filter((group) => group.items.length > 0);
---

<section
  class="transcript-page"
  id="transcript"
>
  <div class="transcript-page__inner">
    <header class="transcript-hero">
      <p class="transcript-kicker">
        Academic Transcript
      </p>
      <div class="transcript-hero__grid">
        <h1>
          Proof of learning.
        </h1>
        <p>
          Formal study, bootcamps, and certificates. Kept tidy, not loud.
        </p>
      </div>
    </header>

    {
      grouped.map((group) => (
        <section class="transcript-group" aria-labelledby={group.id}>
          <div class="transcript-group__head">
            <div>
              <p class="transcript-kicker">
                Record
              </p>
              <h2
                id={group.id}
              >
                {group.section}
              </h2>
            </div>
            <p class="transcript-count">
              {group.items.length} {group.items.length === 1 ? "entry" : "entries"}
            </p>
          </div>
          <div class="transcript-list">
            {group.items.map((item) => (
              <article class="transcript-item">
                <div class="transcript-item__top">
                  <div>
                    <h3>
                      {item.title}
                    </h3>
                    <p class="transcript-item__institution">
                      {item.institution}
                    </p>
                  </div>
                  <div class="transcript-item__meta">
                    <span
                      class:list={[
                        "transcript-status",
                        item.status === "In Progress"
                          ? "transcript-status--progress"
                          : "transcript-status--done",
                      ]}
                    >
                      {item.status}
                    </span>
                    {item.date && (
                      <p class="transcript-date">
                        {item.date}
                      </p>
                    )}
                  </div>
                </div>

                {item.description && (
                  <p class="transcript-item__description">
                    {item.description}
                  </p>
                )}

                {item.detail && (
                  <p class="transcript-item__detail">{item.detail}</p>
                )}

                {item.tags && item.tags.length > 0 && (
                  <div class="mt-4">
                    {item.tagLabel && (
                      <p class="transcript-tag-label">
                        {item.tagLabel}
                      </p>
                    )}
                    <div class="transcript-tags">
                      {item.tags.map((tag) => (
                        <span>
                          {tag}
                        </span>
                      ))}
                    </div>
                  </div>
                )}

                {item.certificateImage && (
                  <button
                    type="button"
                    class="transcript-certificate"
                    data-cert-image={item.certificateImage}
                    data-cert-alt={item.certificateAlt ?? item.title}
                  >
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="16"
                      height="16"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8" />
                      <circle cx="12" cy="12" r="3" />
                    </svg>
                    View Certificate
                  </button>
                )}
              </article>
            ))}
          </div>
        </section>
      ))
    }
  </div>
</section>

<div
  id="cert-modal"
  class="certificate-modal hidden"
  role="dialog"
  aria-modal="true"
  aria-label="Certificate preview"
>
  <div
    class="certificate-modal__panel"
  >
    <button
      id="cert-modal-close"
      type="button"
      class="certificate-modal__close"
      aria-label="Close certificate preview"
    >
      <span aria-hidden="true">×</span>
    </button>
    <img
      id="cert-modal-image"
      src=""
      alt=""
      class="certificate-modal__image"
      loading="lazy"
    />
  </div>
</div>

<script>
  const modal = document.getElementById("cert-modal");
  const modalImage = document.getElementById("cert-modal-image");
  const closeButton = document.getElementById("cert-modal-close");

  function openModal(src, alt) {
    if (!modal || !modalImage) return;
    modalImage.setAttribute("src", src);
    modalImage.setAttribute("alt", alt || "Certificate preview");
    modal.classList.remove("hidden");
    modal.classList.add("flex");
    document.body.style.overflow = "hidden";
  }

  function closeModal() {
    if (!modal || !modalImage) return;
    modal.classList.add("hidden");
    modal.classList.remove("flex");
    modalImage.setAttribute("src", "");
    modalImage.setAttribute("alt", "");
    document.body.style.overflow = "";
  }

  document.querySelectorAll("[data-cert-image]").forEach((button) => {
    button.addEventListener("click", () => {
      const src = button.getAttribute("data-cert-image");
      const alt = button.getAttribute("data-cert-alt");
      if (!src) return;
      openModal(src, alt || "Certificate preview");
    });
  });

  closeButton?.addEventListener("click", closeModal);

  modal?.addEventListener("click", (event) => {
    if (event.target === modal) closeModal();
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") closeModal();
  });
</script>
