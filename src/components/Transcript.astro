---
import { getCollection } from "astro:content";

type TranscriptItem = {
  section: string;
  title: string;
  institution: string;
  status: "Completed" | "In Progress";
  date?: string;
  description?: string;
  detail?: string;
  tagLabel?: string;
  tags?: string[];
  certificateImage?: string;
  certificateAlt?: string;
  order: number;
};

const rawCollections = await getCollection("transcript");
const entries = rawCollections
  .flatMap((entry) => entry.data as TranscriptItem[])
  .sort((a, b) => a.order - b.order);

const sectionOrder = [
  "Formal Degree",
  "Bootcamps & Institutions",
  "Online Courses — Udemy",
  "Online Courses — Great Learning",
];

const grouped = sectionOrder
  .map((section) => ({
    id: `transcript-${section
      .toLowerCase()
      .replace(/[^a-z0-9]+/g, "-")
      .replace(/^-|-$/g, "")}`,
    section,
    items: entries.filter((entry) => entry.section === section),
  }))
  .filter((group) => group.items.length > 0);
---

<section
  class="mx-auto max-w-[68rem] px-5 pb-24 pt-[9.5rem] sm:px-8 md:pb-32 md:pt-[10.5rem]"
  id="transcript"
>
  <div>
    <header class="border-b border-border pb-16 md:pb-20">
      <p class="font-mono text-[0.66rem] uppercase tracking-[0.2em] text-[var(--accent-secondary)]">
        Academic Transcript
      </p>
      <div class="mt-6 grid gap-10 lg:grid-cols-[minmax(0,1.15fr)_minmax(20rem,0.85fr)] lg:gap-20">
        <h1 class="max-w-[36rem] text-[clamp(2.25rem,4.2vw,3.55rem)] font-medium leading-[1.05] tracking-[-0.018em] max-[700px]:max-w-[20.5rem] max-[700px]:text-[clamp(2.15rem,9.5vw,2.75rem)]">
          Qualifications, Bootcamps, and Certifications
        </h1>
        <p class="max-w-[36rem] text-[1.04rem] leading-[1.7] text-muted max-[700px]:max-w-[20rem]">
          A complete in-app transcript of formal education and practical learning,
          with locally hosted certificate previews.
        </p>
      </div>
    </header>

    {
      grouped.map((group) => (
        <section class="border-b border-border py-16 last:border-b-0 md:py-20" aria-labelledby={group.id}>
          <div class="mb-8 flex flex-col gap-4 border-b border-border pb-6 sm:flex-row sm:items-end sm:justify-between">
            <div>
              <p class="font-mono text-[0.66rem] uppercase tracking-[0.2em] text-[var(--accent-secondary)]">
                Record
              </p>
              <h2
                class="mt-2 text-[clamp(2rem,4vw,2.75rem)] font-medium"
                id={group.id}
              >
                {group.section}
              </h2>
            </div>
            <p class="font-mono text-[0.66rem] uppercase tracking-[0.2em] text-[var(--accent-secondary)]">
              {group.items.length} {group.items.length === 1 ? "entry" : "entries"}
            </p>
          </div>
          <div>
            {group.items.map((item) => (
              <article class="border-b border-border py-8 first:pt-0 last:border-b-0 md:py-9">
                <div class="flex flex-col gap-3 md:flex-row md:items-start md:justify-between">
                  <div>
                    <h3 class="max-w-[45rem] font-display text-[clamp(1.35rem,2.6vw,1.7rem)] font-medium leading-tight">
                      {item.title}
                    </h3>
                    <p class="mt-2 font-mono text-[0.74rem] text-primary">
                      {item.institution}
                    </p>
                  </div>
                  <div class="flex flex-col items-start gap-2 md:items-end">
                    <span
                      class:list={[
                        "border px-2.5 py-1 font-mono text-[0.62rem] uppercase tracking-[0.16em]",
                        item.status === "In Progress"
                          ? "border-primary text-primary"
                          : "border-border text-muted",
                      ]}
                    >
                      {item.status}
                    </span>
                    {item.date && (
                      <p class="font-mono text-[0.68rem] uppercase leading-[1.6] tracking-[0.14em] text-subtle md:max-w-[13rem] md:text-right">
                        {item.date}
                      </p>
                    )}
                  </div>
                </div>

                {item.description && (
                  <p class="mt-5 max-w-[45rem] text-[1rem] leading-[1.7] text-muted">
                    {item.description}
                  </p>
                )}

                {item.detail && (
                  <p class="mt-3 max-w-[45rem] text-[0.82rem] leading-[1.6] text-subtle">{item.detail}</p>
                )}

                {item.tags && item.tags.length > 0 && (
                  <div class="mt-4">
                    {item.tagLabel && (
                      <p class="mb-2 font-mono text-[0.66rem] uppercase tracking-[0.16em] text-subtle">
                        {item.tagLabel}
                      </p>
                    )}
                    <div class="flex flex-wrap gap-2">
                      {item.tags.map((tag) => (
                        <span class="border border-border bg-surface px-2.5 py-1 font-mono text-[0.68rem] text-muted">
                          {tag}
                        </span>
                      ))}
                    </div>
                  </div>
                )}

                {item.certificateImage && (
                  <button
                    type="button"
                    class="mt-5 inline-flex items-center gap-2 font-mono text-[0.72rem] text-primary transition-colors hover:text-foreground"
                    data-cert-image={item.certificateImage}
                    data-cert-alt={item.certificateAlt ?? item.title}
                  >
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="16"
                      height="16"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8" />
                      <circle cx="12" cy="12" r="3" />
                    </svg>
                    View Certificate
                  </button>
                )}
              </article>
            ))}
          </div>
        </section>
      ))
    }
  </div>
</section>

<div
  id="cert-modal"
  class="fixed inset-0 z-[70] hidden items-center justify-center bg-black/55 p-4"
  role="dialog"
  aria-modal="true"
  aria-label="Certificate preview"
>
  <div
    class="relative w-full max-w-4xl border border-border bg-background p-3 md:p-4"
  >
    <button
      id="cert-modal-close"
      type="button"
      class="absolute right-3 top-3 h-8 w-8 border border-border bg-background font-mono text-muted transition-colors hover:text-foreground"
      aria-label="Close certificate preview"
    >
      <span aria-hidden="true">×</span>
    </button>
    <img
      id="cert-modal-image"
      src=""
      alt=""
      class="max-h-[80vh] w-full object-contain"
      loading="lazy"
    />
  </div>
</div>

<script>
  const modal = document.getElementById("cert-modal");
  const modalImage = document.getElementById("cert-modal-image");
  const closeButton = document.getElementById("cert-modal-close");

  function openModal(src, alt) {
    if (!modal || !modalImage) return;
    modalImage.setAttribute("src", src);
    modalImage.setAttribute("alt", alt || "Certificate preview");
    modal.classList.remove("hidden");
    modal.classList.add("flex");
    document.body.style.overflow = "hidden";
  }

  function closeModal() {
    if (!modal || !modalImage) return;
    modal.classList.add("hidden");
    modal.classList.remove("flex");
    modalImage.setAttribute("src", "");
    modalImage.setAttribute("alt", "");
    document.body.style.overflow = "";
  }

  document.querySelectorAll("[data-cert-image]").forEach((button) => {
    button.addEventListener("click", () => {
      const src = button.getAttribute("data-cert-image");
      const alt = button.getAttribute("data-cert-alt");
      if (!src) return;
      openModal(src, alt || "Certificate preview");
    });
  });

  closeButton?.addEventListener("click", closeModal);

  modal?.addEventListener("click", (event) => {
    if (event.target === modal) closeModal();
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") closeModal();
  });
</script>
